    const cancelBtn = document.getElementById('cancelDrawerBtn');
    const drawerBackdrop = document.getElementById('drawerBackdrop');
    const confirmBtn = document.getElementById('confirmTransferBtn');

    function openDrawer() {
      drawer.classList.remove('pointer-events-none', 'opacity-0');
      drawerPanel.classList.remove('translate-x-full');
    }

    function closeDrawer() {
      drawer.classList.add('opacity-0');
      drawerPanel.classList.add('translate-x-full');
      setTimeout(() => {
        drawer.classList.add('pointer-events-none');
      }, 300);
    }

    if (openBtn) openBtn.addEventListener('click', openDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (cancelBtn) cancelBtn.addEventListener('click', closeDrawer);
    if (drawerBackdrop) drawerBackdrop.addEventListener('click', closeDrawer);

    if (confirmBtn) {
      confirmBtn.addEventListener('click', () => {
        confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Generating Pass...';
        setTimeout(() => {
          closeDrawer();
          confirmBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">verified</span> Issue Transfer &amp; Gate Pass';
        }, 800);
      });
    }

    // Telemetry Modal Interactions
    const telemetryModal = document.getElementById('telemetryModal');
    const telemetryBackdrop = document.getElementById('telemetryBackdrop');
    const closeTelemetryBtn = document.getElementById('closeTelemetryModalBtn');
    const telemetryBtns = document.querySelectorAll('.openTelemetryModalBtn');

    telemetryBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const trId = btn.getAttribute('data-tr') || 'TR-2024-1082';
        const carrier = btn.getAttribute('data-carrier') || 'BlueDart Pharma Cold';
        document.getElementById('modalTrTitle').textContent = trId;
        document.getElementById('modalCarrierInfo').textContent = `${carrier} • Active IoT Gateway`;

        telemetryModal.classList.remove('pointer-events-none', 'opacity-0');
        const modalBox = telemetryModal.querySelector('.relative');
        if (modalBox) modalBox.classList.remove('scale-95');
      });
    });

    function closeTelemetry() {
      telemetryModal.classList.add('opacity-0');
      const modalBox = telemetryModal.querySelector('.relative');
      if (modalBox) modalBox.classList.add('scale-95');
      setTimeout(() => {
        telemetryModal.classList.add('pointer-events-none');
      }, 200);
    }

    if (closeTelemetryBtn) closeTelemetryBtn.addEventListener('click', closeTelemetry);
    if (telemetryBackdrop) telemetryBackdrop.addEventListener('click', closeTelemetry);

    // Tab buttons styling toggling
    const tabButtons = document.querySelectorAll('.tab-btn');
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        tabButtons.forEach(b => {
          b.classList.remove('bg-primary-container', 'text-on-primary');
          b.classList.add('bg-surface-container-lowest', 'text-on-surface-variant');
        });
        button.classList.add('bg-primary-container', 'text-on-primary');
        button.classList.remove('bg-surface-container-lowest', 'text-on-surface-variant');
      });
