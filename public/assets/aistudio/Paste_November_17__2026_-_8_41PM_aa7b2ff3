<script>
  function showToast(msg, icon = 'check_circle') {
    const toast = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMessage');
    const toastIcon = document.getElementById('toastIcon');
    if (!toast) return;

    toastMsg.textContent = msg;
    toastIcon.textContent = icon;
    toast.classList.remove('translate-y-24', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');

    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0', 'pointer-events-none');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 3800);
  }

  function triggerWebhookSim() {
    showToast('Simulating live webhook: Razorpay payment.captured [TXN-9921409, ₹2,190.00]', 'cloud_sync');
  }

  function openRefundDrawer() {
    const panel = document.getElementById('refundPanelContainer');
    if (panel) {
      panel.classList.remove('hidden');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function closeRefundDrawer() {
    const panel = document.getElementById('refundPanelContainer');
    if (panel) {
      // For desktop responsiveness, toggle visibility or reset state
      showToast('Refund reconciliation dismissed without ledger posting.', 'info');
    }
  }

  function loadRefundDrawer(orderId, customer, amount, method, utr) {
    openRefundDrawer();
    document.getElementById('drawerTargetOrderId').textContent = '#' + orderId;
    document.getElementById('drawerTargetCustomer').textContent = customer;
    document.getElementById('drawerOriginalTotal').textContent = '₹' + amount;
    document.getElementById('drawerOrigMethod').textContent = 'Paid via ' + method;
    document.getElementById('drawerOrigUTR').textContent = 'UTR: ' + utr;
    
    // Partial refund formula example for single formulation
    const partial = (parseFloat(amount) > 500) ? '₹115.00' : '₹' + (parseFloat(amount) * 0.5).toFixed(2);
    document.getElementById('proposedRefundDisplay').textContent = partial;
    document.getElementById('btnRefundText').textContent = 'Authorize & Process Refund (' + partial + ')';
    showToast('Loaded ledger context for ' + orderId, 'sync');
  }

  function submitRefundProcess() {
    const amount = document.getElementById('proposedRefundDisplay').textContent;
    const orderId = document.getElementById('drawerTargetOrderId').textContent;
    showToast('Instant IMPS Reversal of ' + amount + ' dispatched for ' + orderId + '. RBI Node Synced.', 'task_alt');
  }

  function openPayloadModal(txnId, gateway, amount, status) {
    const modal = document.getElementById('payloadModal');
    if (!modal) return;
    document.getElementById('modalTxnTitle').textContent = 'Gateway JSON Payload: #' + txnId;
    document.getElementById('modalGatewaySource').textContent = gateway;
    document.getElementById('modalStatusBadge').textContent = 'STATUS: ' + status;
    
    const mockJson = {
      event: "payment.settlement.webhook",
      transaction_id: txnId,
      gateway: gateway,
      amount_inr: amount,
      rbi_node: "NPCI-IMPS-BLR-01",
      settlement_account: "MediCare Central Escrow #RBI-991",
      timestamp_ist: new Date().toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata' }) + " IST",
      signature: "0x892a..fca21b09"
    };

    document.getElementById('jsonPayloadArea').textContent = JSON.stringify(mockJson, null, 2);
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closePayloadModal() {
    const modal = document.getElementById('payloadModal');
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script></main></div></body></html>

