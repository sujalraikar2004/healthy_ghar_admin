<script>
  (function() {
    // Zoom and Pan Controls
    const rxDoc = document.getElementById('rx-document');
    const zoomInBtn = document.getElementById('zoom-in-btn');
    const zoomOutBtn = document.getElementById('zoom-out-btn');
    const zoomVal = document.getElementById('zoom-val');
    const rotateBtn = document.getElementById('rotate-btn');
    const filterBtn = document.getElementById('invert-filter-btn');

    let currentScale = 1.0;
    let currentRotation = 0;
    let isBwMode = false;

    function updateTransform() {
      rxDoc.style.transform = `scale(${currentScale}) rotate(${currentRotation}deg)`;
      zoomVal.textContent = `${Math.round(currentScale * 100)}%`;
    }

    if (zoomInBtn && zoomOutBtn) {
      zoomInBtn.addEventListener('click', () => {
        if (currentScale < 1.8) {
          currentScale += 0.15;
          updateTransform();
        }
      });

      zoomOutBtn.addEventListener('click', () => {
        if (currentScale > 0.7) {
          currentScale -= 0.15;
          updateTransform();
        }
      });
    }

    if (rotateBtn) {
      rotateBtn.addEventListener('click', () => {
        currentRotation = (currentRotation + 90) % 360;
        updateTransform();
      });
    }

    if (filterBtn) {
      filterBtn.addEventListener('click', () => {
        isBwMode = !isBwMode;
        if (isBwMode) {
          rxDoc.style.filter = 'grayscale(100%) contrast(160%)';
          filterBtn.classList.add('bg-surface-container', 'text-primary');
        } else {
          rxDoc.style.filter = 'none';
          filterBtn.classList.remove('bg-surface-container', 'text-primary');
        }
      });
    }

    // Modal controls for Rejection / Clarification
    const actionModal = document.getElementById('action-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalConfirmBtn = document.getElementById('modal-confirm-btn');
    const modalCancelBtn = document.getElementById('modal-cancel-btn');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const btnOpenReject = document.getElementById('btn-open-reject');
    const btnOpenClarify = document.getElementById('btn-open-clarify');
    const modalReasonText = document.getElementById('modal-reason-text');
    const reasonPills = document.querySelectorAll('.reason-pill');

    function openModal(title, isReject) {
      modalTitle.textContent = title;
      if (isReject) {
        modalConfirmBtn.className = "px-4 py-2 rounded-lg bg-error text-on-error font-title-md text-body-sm hover:opacity-90 shadow-sm transition-opacity";
        modalConfirmBtn.textContent = "Confirm Rejection";
      } else {
        modalConfirmBtn.className = "px-4 py-2 rounded-lg bg-primary-container text-on-primary font-title-md text-body-sm hover:bg-primary shadow-sm transition-all";
        modalConfirmBtn.textContent = "Send Clarification Request";
      }
      actionModal.classList.remove('hidden');
      actionModal.classList.add('flex');
    }

    function closeModal() {
      actionModal.classList.add('hidden');
      actionModal.classList.remove('flex');
      modalReasonText.value = '';
      reasonPills.forEach(p => p.classList.remove('bg-primary-container', 'text-on-primary'));
    }

    if (btnOpenReject) {
      btnOpenReject.addEventListener('click', () => openModal('Reject Prescription & Cancel Item Lines', true));
    }
    if (btnOpenClarify) {
      btnOpenClarify.addEventListener('click', () => openModal('Request Patient Prescription Clarification', false));
    }
    if (modalCancelBtn) modalCancelBtn.addEventListener('click', closeModal);
    if (modalCloseBtn) modalCloseBtn.addEventListener('click', closeModal);

    reasonPills.forEach(pill => {
      pill.addEventListener('click', () => {
        modalReasonText.value = pill.textContent.trim();
        reasonPills.forEach(p => p.classList.remove('bg-primary-container', 'text-on-primary'));
        pill.classList.add('bg-primary-container', 'text-on-primary');
      });
    });

    // Approval Button Action
    const btnApprove = document.getElementById('btn-approve');
    const checkH1 = document.getElementById('check-h1-sign');
    const check1 = document.getElementById('check-med-1');
    const check2 = document.getElementById('check-med-2');
    const check3 = document.getElementById('check-med-3');

    if (btnApprove) {
      btnApprove.addEventListener('click', () => {
        if (!checkH1.checked) {
          alert('Regulatory Notice: Please verify and check Schedule H1 register signature before dispensing.');
          checkH1.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        check1.checked = true;
        check2.checked = true;
        check3.checked = true;
        btnApprove.innerHTML = `<span class="material-symbols-outlined text-[18px]">check_circle</span><span>Authorized & Dispatched</span>`;
        btnApprove.classList.add('bg-surface-container', 'text-on-surface', 'cursor-not-allowed');
        btnApprove.disabled = true;
      });
    }
  })();
</script></main></div></body></html>

