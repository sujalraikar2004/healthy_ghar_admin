    document.getElementById('drawerBatchTag').innerText = 'Batch ' + batch;
    document.getElementById('drawerMfg').innerText = mfg;
    document.getElementById('drawerExp').innerText = exp;
    document.getElementById('drawerDays').innerText = days + ' Remaining';
    document.getElementById('drawerConditionTag').innerText = cond;
    document.getElementById('drawerStock').innerText = stock;
    document.getElementById('inspectionDrawer').classList.remove('hidden');
  }

  function closeDrawer() {
    document.getElementById('inspectionDrawer').classList.add('hidden');
  }

  function setFilter(button, horizon) {
    const pills = document.querySelectorAll('.filter-pill');
    pills.forEach(p => {
      p.classList.remove('bg-primary-container', 'text-on-primary', 'active');
      p.classList.add('bg-surface-container-low', 'text-on-surface-variant');
    });
    button.classList.add('bg-primary-container', 'text-on-primary', 'active');
    button.classList.remove('bg-surface-container-low', 'text-on-surface-variant');

    applyFilter(horizon);
  }

  function applyFilter(horizon) {
    const rows = document.querySelectorAll('.batch-row');
    rows.forEach(row => {
      if (horizon === 'all' || row.getAttribute('data-horizon') === horizon) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function filterWarehouse(hub) {
    const rows = document.querySelectorAll('.batch-row');
    rows.forEach(row => {
      if (hub === 'all' || row.getAttribute('data-hub') === hub) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function filterRows() {
    const query = document.getElementById('batchSearch').value.toLowerCase();
    const rows = document.querySelectorAll('.batch-row');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      if (text.includes(query)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }
