<!-- Interactive script to handle tabs, queue balancing, and client filtering -->
<script>
    function switchRxTab(tabKey, el) {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-surface-container-lowest', 'text-primary', 'shadow-sm');
        btn.classList.add('text-on-surface-variant');
      });
      el.classList.add('bg-surface-container-lowest', 'text-primary', 'shadow-sm');
      el.classList.remove('text-on-surface-variant');
      
      const rows = document.querySelectorAll('.rx-row');
      rows.forEach(row => {
        if (tabKey === 'all') {
          row.style.display = 'table-row';
        } else if (row.dataset.status === tabKey) {
          row.style.display = 'table-row';
        } else {
          row.style.display = 'none';
        }
      });
    }

    function triggerAutoBalance() {
      const btn = document.getElementById('auto-balance-btn');
      const originalText = btn.innerHTML;
      btn.innerHTML = '<span class="material-symbols-outlined text-[16px] animate-spin">refresh</span> Re-allocating 18 records...';
      btn.disabled = true;
      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check_circle</span> Queue Re-Balanced evenly';
        btn.classList.add('bg-primary', 'text-on-primary');
        btn.classList.remove('bg-surface-container-lowest');
        const unassignedBadge = document.getElementById('unassigned-tag');
        if (unassignedBadge) {
          unassignedBadge.innerText = 'Dr. Rajesh Pillai';
          unassignedBadge.className = 'font-label-sm text-label-sm px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container';
        }
        setTimeout(() => {
          btn.innerHTML = originalText;
          btn.disabled = false;
          btn.classList.remove('bg-primary', 'text-on-primary');
          btn.classList.add('bg-surface-container-lowest');
        }, 2600);
      }, 900);
    }
  </script>
